{
  "expo": {
    "name": "Terra Call",
    "slug": "mobile",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_v2_text.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon_v2_text.png",
      "resizeMode": "contain",
      "backgroundColor": "#060a18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.terracall.app",
      "buildNumber": "1",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "UIBackgroundModes": ["audio", "voip"],
        "NSCameraUsageDescription": "Terra Call uses your camera so a trusted caregiver can see you during an emergency check-in. The camera only activates after you give consent and only when a caregiver initiates an emergency call.",
        "NSMicrophoneUsageDescription": "Terra Call uses your microphone during emergency video check-ins so you can talk with your caregiver.",
        "NSLocationWhenInUseUsageDescription": "Terra Call shares your location with your caregiver during emergency check-ins so they can find you quickly.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.terracall.mobile",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.READ_PHONE_NUMBERS",
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon_v2_text.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/withAndroidMapsKey",
      "@config-plugins/react-native-callkeep",
      "./plugins/withNativeCalls",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon_v2_text.png",
          "color": "#22FF6E",
          "sounds": [
            "./assets/sounds/terra_call_alert.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "@twilio/video-react-native-sdk",
        {
          "cameraPermission": "Terra Call uses your camera so a trusted caregiver can see you during an emergency check-in. The camera only activates after you give consent and only when a caregiver initiates an emergency call.",
          "microphonePermission": "Terra Call uses your microphone during emergency video check-ins so you can talk with your caregiver."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Terra Call uses your camera so a trusted caregiver can see you during an emergency check-in. The camera only activates after you give consent and only when a caregiver initiates an emergency call.",
          "microphonePermission": "Terra Call uses your microphone during emergency video check-ins so you can talk with your caregiver.",
          "recordAudioAndroid": true
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "nativeCallApnsEnvironment": "production",
      "eas": {
        "projectId": "715d9c4f-6a1b-407b-8b3a-e2a43d458682"
      }
    },
    "owner": "terracall",
    "runtimeVersion": "1.6.0",
    "updates": {
      "url": "https://u.expo.dev/715d9c4f-6a1b-407b-8b3a-e2a43d458682"
    }
  }
}
