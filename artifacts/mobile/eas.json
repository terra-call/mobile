{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://caregiver-connect-terracall.replit.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://caregiver-connect-terracall.replit.app"
      }
    },
    "production": {
      "node": "22.16.0",
      "pnpm": "10.26.1",
      "android": {
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      },
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://caregiver-connect-terracall.replit.app"
      },
      "credentialsSource": "remote"
    }
  },
  "submit": {
    "production": {}
  }
}