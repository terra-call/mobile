// ───────────────────────────────────────────────────────────────────────────
// Terra Call — Firestore security rules
//
// IMPORTANT: This file is a REFERENCE / TEMPLATE.  Firebase reads its rules
// from the Firebase Console (Firestore Database → Rules), NOT from this repo.
//
// The rules below cover BOTH:
//   • the existing collections that already work in production (`users`,
//     `invites`, `events`) — copied here so the file is complete and the
//     rules can be deployed in one paste, AND
//   • the new collections added for v1.1 organization / Medicaid support
//     (`organizations`, `auditLogs`, `careReports`).
//
// → To deploy: open Firebase Console → Firestore Database → Rules tab,
//   review each block against your live rules, and publish.  If your live
//   rules for `users`/`invites`/`events` differ from what is shown below,
//   keep YOUR live versions and only ADD the three new match blocks
//   marked `// FUTURE — Organization/Medicaid support (v1.1)`.
// ───────────────────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOrgAdmin(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == orgId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationRole == 'agency_admin';
    }

    // ── EXISTING — users ─────────────────────────────────────────────────
    // (Mirror of your live rule.  If your live rule differs, KEEP your live
    // version and ignore this block.)
    match /users/{userId} {
      allow read: if isSignedIn();   // caregivers need to look up their receivers
      allow create: if isSelf(userId);
      allow update: if isSelf(userId) || isAdmin()
        // Caregiver self-removal: a caregiver deleting their own account may
        // remove ONLY themselves from a recipient's caregiver link arrays.
        // The update may touch nothing but the two link fields, and the
        // resulting ID list must equal the old list minus the caller's uid.
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['permittedCaregiverIds', 'permittedCaregivers'])
            && request.auth.uid in resource.data.permittedCaregiverIds
            && request.resource.data.permittedCaregiverIds
                 == resource.data.permittedCaregiverIds.removeAll([request.auth.uid]));
      // Self-delete supports the App Store / Play Store account-deletion
      // requirement (the app scrubs PHI first, then deletes the doc).
      allow delete: if isSelf(userId) || isAdmin();
    }

    // ── EXISTING — invites ───────────────────────────────────────────────
    match /invites/{inviteId} {
      allow read, write: if isSignedIn();
    }

    // ── EXISTING — events (admin dashboard activity feed) ────────────────
    match /events/{eventId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── NEW — cameraActivations (Firestore signaling fallback) ───────────
    // Primary delivery channel for "wake the receiver's camera" requests.
    // The mobile receiver app subscribes via onSnapshot, so it triggers
    // even when push notifications can't be delivered (FCM-blocked Android,
    // missing iOS APNs entitlement, silent mode, low power, etc).
    //
    //   • CREATE: any signed-in caller. The /api/video/initiate route writes
    //     these on the caller's behalf AFTER server-side
    //     `isPermittedForReceiver` confirms the caller is a permitted
    //     caregiver. We require callerUid == request.auth.uid to bind the
    //     row to the verified Firebase identity.
    //   • READ:   only the receiver may subscribe (receiverUid == auth.uid).
    //   • UPDATE: only the receiver, and only the `status` / `processedAt`
    //     fields, so the receiver can mark a row "processed" after handling.
    //   • DELETE: nobody. Records are kept for the audit trail; a TTL policy
    //     in the Firebase Console can sweep old rows server-side.
    match /cameraActivations/{activationId} {
      // CREATE — strict schema + relationship check. The caller must be
      // either (a) the receiver themselves, or (b) a permitted caregiver
      // listed on the receiver's user doc. We check membership against the
      // denormalized `permittedCaregiverIds: string[]` field (kept in sync
      // with `permittedCaregivers` at every mutation site) because Firestore
      // rules cannot iterate map values inside an array of objects.
      //
      // This enforces the same authorization at the rule level that the
      // server's /api/video/initiate route enforces via isPermittedForReceiver
      // — closing the gap where a malicious client could write directly to
      // Firestore and bypass the server gate to trigger camera activation
      // on arbitrary receivers.
      allow create: if isSignedIn()
                    && request.resource.data.callerUid == request.auth.uid
                    && request.resource.data.roomName is string
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp
                    && (
                         // EMERGENCY direction: caregiver → recipient (or recipient → self).
                         // Branch is mutually exclusive with the recipient flow:
                         // emergency docs MUST NOT carry the initiatedBy/caregiverId
                         // discriminators — otherwise a caregiver with emergency
                         // permission on recipient A could craft a forged
                         // "recipient-initiated" doc that points at an arbitrary
                         // caregiver B's IncomingCallListener.
                         (request.resource.data.receiverUid is string
                          && !('initiatedBy' in request.resource.data)
                          && !('caregiverId' in request.resource.data)
                          && !('recipientId' in request.resource.data)
                          && (
                               request.resource.data.receiverUid == request.auth.uid
                               ||
                               request.auth.uid in
                                 get(/databases/$(database)/documents/users/$(request.resource.data.receiverUid))
                                   .data.permittedCaregiverIds
                             ))
                         ||
                         // RECIPIENT-INITIATED direction: recipient → caregiver
                         // ("Call My Caregiver" blue button). Caller must be the
                         // recipient themselves and the named caregiverId must be
                         // listed on their own permittedCaregiverIds array.
                         // MUST NOT carry receiverUid so the emergency receiver
                         // listener cannot be triggered by this branch.
                         (request.resource.data.initiatedBy == 'recipient'
                          && !('receiverUid' in request.resource.data)
                          && request.resource.data.recipientId == request.auth.uid
                          && request.resource.data.caregiverId is string
                          && request.resource.data.caregiverId in
                             get(/databases/$(database)/documents/users/$(request.auth.uid))
                               .data.permittedCaregiverIds)
                       );
      // READ — three audiences:
      //   1. The recipient receiving an emergency push (receiverUid match)
      //   2. The caregiver being called by a recipient (caregiverId match on
      //      recipient-initiated docs)
      //   3. The recipient who initiated their own call, so they can subscribe
      //      to status transitions (answered / declined)
      allow read:   if isSignedIn() && (
                         (resource.data.receiverUid is string
                          && resource.data.receiverUid == request.auth.uid)
                         ||
                         (resource.data.initiatedBy == 'recipient'
                          && (resource.data.caregiverId == request.auth.uid
                              || resource.data.recipientId == request.auth.uid))
                       );
      // UPDATE — three permitted state transitions, all from status=='pending':
      //   • EMERGENCY: receiver marks own doc 'processed' (existing behavior)
      //   • RECIPIENT-INITIATED: caregiver responds 'answered' or 'declined'
      //   • RECIPIENT-INITIATED: recipient cancels their own outgoing call
      allow update: if isSignedIn()
                    && resource.data.status == 'pending'
                    && (
                         (resource.data.receiverUid is string
                          && resource.data.receiverUid == request.auth.uid
                          && request.resource.data.status == 'processed'
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly(['status', 'processedAt']))
                         ||
                         (resource.data.initiatedBy == 'recipient'
                          && resource.data.caregiverId == request.auth.uid
                          && (request.resource.data.status == 'answered'
                              || request.resource.data.status == 'declined')
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly(['status', 'respondedAt']))
                         ||
                         (resource.data.initiatedBy == 'recipient'
                          && resource.data.recipientId == request.auth.uid
                          && request.resource.data.status == 'cancelled'
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly(['status', 'cancelledAt']))
                       );
      allow delete: if false;
    }

    // ── FUTURE — Organization/Medicaid support (v1.1) ────────────────────
    // organizations: B2B account records.
    // Readable by app admin and by org admins of that organization only.
    // Writable by app admin only — billing/contract fields (pmpmRate,
    // subscriptionTier, contractStartDate/EndDate, etc.) must NOT be
    // mutable by org admins.  Org admins manage their members through
    // the `users` collection, not the org record.
    match /organizations/{orgId} {
      allow read:   if isAdmin() || isOrgAdmin(orgId);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── FUTURE — Organization/Medicaid support (v1.1) ────────────────────
    // auditLogs: HIPAA-required append-only audit trail.
    //   • Authenticated users may CREATE entries only for their own actions
    //     (request.resource.data.userId must equal their auth uid).
    //   • Entries are immutable: no update, no delete, ever.
    //   • Only the app admin may read.
    //   • v1.1 TODO: move audit writes to a Cloud Function so the client
    //     cannot create entries at all and writes are truly system-only.
    match /auditLogs/{logId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── FUTURE — Organization/Medicaid support (v1.1) ────────────────────
    // careReports: periodic care-activity rollups.
    // Readable by:
    //   • the care recipient themselves
    //   • any caregiver listed in caregiverIds
    //   • the organization admin of report.organizationId
    //   • the app admin
    // Writable by app admin only (reports are generated server-side; until
    // v1.1 Cloud Functions ship, only the admin tool may create them).
    match /careReports/{reportId} {
      allow read: if isSignedIn() && (
                       isAdmin()
                    || resource.data.careReceiverId == request.auth.uid
                    || request.auth.uid in resource.data.caregiverIds
                    || (resource.data.organizationId != null
                        && isOrgAdmin(resource.data.organizationId))
                  );
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
